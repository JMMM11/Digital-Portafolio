{
  "name": "digital-portafolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portafolio personal de Jair M. Morales Magallon. Sitio estatico hecho con Astro.",
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview",
    "start": "node scripts/astro.mjs dev",
    "vendor": "node scripts/copy-vendor.mjs",
