---
/* PAGINA 404: una terminal que no encuentra el archivo. GitHub Pages la muestra sola. */
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Base title="404 | Jair M. Morales Magallon" description="This page does not exist." page="404" scripts={["js/name-water.js"]}>
      <div class="wrap page-head">
        <p class="crumb">~/jair/404</p>
        <h1 data-intro>Page not found.</h1>
        <div class="terminal-404" data-intro>
          <p><span class="t-prompt">$</span> cat this-page.html</p>
          <p class="t-error">cat: this-page.html: No such file or directory</p>
          <p><span class="t-prompt">$</span> cd ~ &amp;&amp; ls</p>
          <p class="t-links"><a href={base}>home/</a> <a href={`${base}projects.html`}>projects/</a> <a href={`${base}contact.html`}>contact/</a></p>
        </div>
      </div>
</Base>
