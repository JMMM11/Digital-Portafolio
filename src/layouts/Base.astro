---
/*
 * PLANTILLA DE TODAS LAS PAGINAS: <head>, cabecera, contenido y pie.
 * Props:
 *   title, description  textos de la pestana y de buscadores (ingles; el espanol esta en js/i18n-es.js)
 *   page                nombre de la pagina ("index", "about"...): marca el menu y arma la URL
 *   scripts / styles    archivos extra de esa pagina (en public/), se cargan antes de site.js
 * Los archivos de public/ (css, js, assets) se sirven tal cual.
 */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  page: string;
  scripts?: string[];
  styles?: string[];
}
const { title, description, page, scripts = [], styles = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const site = "https://jmmm11.github.io/Digital-Portafolio/";
const url = page === "index" ? site : `${site}${page}.html`;
const ogImage = `${site}assets/images/og-image.jpg`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f0e6">
    <meta name="color-scheme" content="light">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={url}>
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={url}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" type="image/svg+xml" href={`${base}assets/images/favicon.svg`}>
    <!-- theme.js va primero: marca el idioma, la precarga y la entrada antes de pintar la pagina. -->
    <script is:inline src={`${base}js/theme.js`}></script>
    <link rel="preload" href={`${base}assets/fonts/instrument-serif-400.woff2`} as="font" type="font/woff2" crossorigin>
    <link rel="preload" href={`${base}assets/fonts/instrument-sans-variable.woff2`} as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href={`${base}css/styles.css`}>
    {styles.map((href) => <link rel="stylesheet" href={`${base}${href}`}>)}
    <script is:inline defer src={`${base}js/vendor/motion.js`}></script>
    {scripts.map((src) => <script is:inline defer src={`${base}${src}`}></script>)}
    <script is:inline defer src={`${base}js/i18n-es.js`}></script>
    <script is:inline defer src={`${base}js/vendor/lenis.min.js`}></script>
    <script is:inline defer src={`${base}js/site.js`}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
